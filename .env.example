# API
PORT=8787
NODE_ENV=development
TEE_MODE=local-dev-sim
TEE_PROVIDER=simulated-attestation
TEE_ATTESTATION_AUDIENCE=tee-ai-experiments

# Sealed model + SAE (downloaded once by `npm run fetch:artifacts`; the runner then runs offline)
TEE_AI_LLM_MODEL_ID=google/gemma-3-1b-pt
TEE_AI_SAE_REPO=google/gemma-scope-2-1b-pt
TEE_AI_SAE_SUBFOLDER=resid_post/layer_13_width_16k_l0_medium
# Needed only for fetch:artifacts (Gemma is gated; accept the licence on Hugging Face first)
HF_TOKEN=
# Set to 0 to let the runner reach the Hub at load time (never in production)
HF_HUB_OFFLINE=1
# CPU threads for torch (defaults to all cores)
TEE_AI_TORCH_THREADS=

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
EXPERIMENT_RECEIPTS_PROGRAM_ID=Bvvhk5LPD9STKEpK2hFEfdTumf5qGTSJfFyn5W97XiuR

# Verification
# Comma-separated sha256(SPKI DER) fingerprints of runner keys the audit should accept
TRUSTED_RUNNER_PUBKEY_FINGERPRINT=
TEE_AI_RUN_TIMEOUT_MS=1200000

# Production hardening toggles
ALLOW_RAW_TEE_EVIDENCE=0
DISABLE_SOLANA_COMMIT=0

# Frontend on Vercel. Leave empty for same-origin/local API proxy.
VITE_API_BASE_URL=
