{
  "name": "tee-ai-experiments",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx src/server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "start": "node dist-server/src/server/index.js",
    "build": "npm run build:server && npm run build:frontend",
    "build:server": "rm -rf dist-server && tsc -p tsconfig.server.json",
    "build:frontend": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "fetch:artifacts": ".venv/bin/python scripts/fetch_artifacts.py",
    "llm:test": ".venv/bin/python src/model/model_runner.py selftest",
    "registry:validate": "tsx scripts/validateRegistry.ts",
    "api:test": "tsx scripts/smoke.ts",
    "key:export": "tsx scripts/exportRunnerKey.ts",
    "audit:public": "tsx scripts/publicAudit.ts",
    "chain:test": "tsx scripts/devnetCommit.ts",
    "test": "npm run llm:test && npm run typecheck && npm run registry:validate && npm run build && npm run api:test"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@solana/web3.js": "^1.98.4",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "helmet": "^7.2.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.5"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "source-map-js@<1.2.2": "^1.2.2",
    "proxy-addr@<2.0.8": "^2.0.8",
    "stream-json@<3.6.0": "^3.6.0",
    "baseline-browser-mapping@<2.11.0": "^2.11.0",
    "qs@<6.16.0": "^6.16.0",
    "browserslist@<4.28.7": "^4.28.7",
    "postcss@<8.5.23": "^8.5.23",
    "body-parser@<1.20.6": "^1.20.6",
    "shell-quote@<1.9.0": "^1.9.0",
    "esbuild@<0.28.1": "^0.28.1"
  }
}
